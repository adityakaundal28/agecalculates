---
import CalcPage from "../layouts/CalcPage.astro";
const faq = [{ q: "How precise are the results?", a: "Conversions use exact or internationally agreed factors and are shown to up to 8 significant digits." }];
---
<CalcPage slug="unit-converter" title="Unit Converter: Length, Weight, Temp" description="Free unit converter for length, weight, temperature, volume and speed. Switch between metric and imperial units instantly, with accurate results on any device." heading="Unit Converter" intro="Pick a type, enter a value, and see it in the units you need." faq={faq}>
  <section data-calc class="card-lg grid gap-8 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)]">
    <form class="space-y-5" onsubmit="return false" novalidate>
      <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Measurement type" data-types></div>
      <div><label for="val" class="field-label">Value</label><input id="val" class="input" inputmode="decimal" value="1" autocomplete="off" /></div>
      <div><label for="from" class="field-label">From</label><select id="from" class="input"></select></div>
    </form>
    <div aria-live="polite">
      <p class="eyebrow">Converted</p>
      <ul data-out="list" class="mt-3 divide-y divide-hairline rounded-md border border-hairline"></ul>
    </div>
  </section>
</CalcPage>

<script>
  type U = { name: string; f: number };
  const L: Record<string, Record<string, U>> = {
    Length: { m: { name: "Meters", f: 1 }, km: { name: "Kilometers", f: 1000 }, cm: { name: "Centimeters", f: 0.01 }, mm: { name: "Millimeters", f: 0.001 }, mi: { name: "Miles", f: 1609.344 }, yd: { name: "Yards", f: 0.9144 }, ft: { name: "Feet", f: 0.3048 }, in: { name: "Inches", f: 0.0254 } },
    Weight: { kg: { name: "Kilograms", f: 1 }, g: { name: "Grams", f: 0.001 }, lb: { name: "Pounds", f: 0.45359237 }, oz: { name: "Ounces", f: 0.028349523125 }, st: { name: "Stone", f: 6.35029318 }, t: { name: "Metric tons", f: 1000 } },
    Volume: { l: { name: "Liters", f: 1 }, ml: { name: "Milliliters", f: 0.001 }, gal: { name: "US gallons", f: 3.785411784 }, qt: { name: "US quarts", f: 0.946352946 }, cup: { name: "US cups", f: 0.2365882365 }, floz: { name: "US fl oz", f: 0.0295735295625 }, igal: { name: "UK gallons", f: 4.54609 } },
    Speed: { ms: { name: "Meters / second", f: 1 }, kmh: { name: "Kilometers / hour", f: 1 / 3.6 }, mph: { name: "Miles / hour", f: 0.44704 }, kn: { name: "Knots", f: 0.514444444 } },
    Temperature: { c: { name: "Celsius", f: 1 }, f: { name: "Fahrenheit", f: 1 }, k: { name: "Kelvin", f: 1 } },
  };
  const toC = (u: string, v: number) => (u === "c" ? v : u === "f" ? ((v - 32) * 5) / 9 : v - 273.15);
  const fromC = (u: string, v: number) => (u === "c" ? v : u === "f" ? (v * 9) / 5 + 32 : v + 273.15);
  const root = document.querySelector<HTMLElement>("[data-calc]")!;
  const sel = root.querySelector<HTMLSelectElement>("#from")!, val = root.querySelector<HTMLInputElement>("#val")!;
  const list = root.querySelector<HTMLElement>("[data-out=list]")!, types = root.querySelector<HTMLElement>("[data-types]")!;
  let type = "Length";
  const num = (n: number) => (Math.abs(n) >= 1e12 || (n !== 0 && Math.abs(n) < 1e-6) ? n.toExponential(4) : Number(n.toPrecision(8)).toLocaleString("en-US", { maximumFractionDigits: 8 }));
  function setType(t: string) {
    type = t;
    types.querySelectorAll("button").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.t === t)));
    sel.replaceChildren(...Object.entries(L[t]).map(([k, u]) => new Option(u.name, k)));
    update();
  }
  function update() {
    const x = parseFloat(val.value.replace(/,/g, ""));
    list.replaceChildren();
    if (!Number.isFinite(x)) return;
    for (const [k, u] of Object.entries(L[type])) {
      const r = type === "Temperature" ? fromC(k, toC(sel.value, x)) : (x * L[type][sel.value].f) / u.f;
      const li = document.createElement("li");
      li.className = "flex items-baseline justify-between gap-4 px-4 py-3";
      const a = document.createElement("span"); a.textContent = u.name;
      const b = document.createElement("span"); b.className = "stat-num"; b.textContent = num(r);
      li.append(a, b); list.append(li);
    }
  }
  for (const t of Object.keys(L)) {
    const b = document.createElement("button");
    b.type = "button"; b.className = "pill-tab"; b.setAttribute("role", "radio"); b.dataset.t = t; b.textContent = t;
    b.addEventListener("click", () => setType(t));
    types.append(b);
  }
  sel.addEventListener("input", update); val.addEventListener("input", update);
  setType("Length");
</script>
