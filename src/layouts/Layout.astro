---
import "../styles/global.css";
import { calculators, categories, accentOf } from "../data/calculators";
import { iconSvg } from "../lib/icons";

interface Props { title: string; description: string; jsonLd?: object[]; keywords?: string; image?: string; noindex?: boolean }
const defaultKeywords = "age calculator, age calculator by date of birth, age calculator of india, age calculator of child, age calculator of dob, calculator, age calculator online, age calculator app";
const { title, description, jsonLd = [], keywords = defaultKeywords, image = "/og-image.png", noindex = false } = Astro.props;
const imageUrl = new URL(image, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes("AgeCalculates") ? title : `${title} | AgeCalculates`;
const searchItems = calculators.map(({ slug, name, desc, keywords }) => ({ slug, name, desc, keywords }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1f1ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Calculator" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="author" content="AgeCalculates" />
    <meta property="og:site_name" content="AgeCalculates" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Age Calculator by AgeCalculates: find your exact age online" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark");
      } catch (e) {}
    </script>
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body class="flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-primary focus:px-3 focus:py-2 focus:text-on-primary">Skip to content</a>

    <header class="sticky top-0 z-30 border-b border-hairline bg-canvas/85 backdrop-blur">
      <div class="flex h-14 w-full items-center gap-2 px-4 sm:px-6">
        <a href="/" class="mr-2 flex items-center gap-2 font-semibold tracking-tight text-ink" aria-label="Age Calculator home">
          <img src="/logo.png" alt="" width="32" height="32" class="size-8 dark:drop-shadow-[0_0_1px_rgb(255_255_255/0.9)]" />
          <span class="text-[15px]">Age Calculator</span>
        </a>
        <nav aria-label="Primary" class="hidden items-center sm:flex">
          <a class="rounded-full px-3 py-2 text-body transition-colors hover:text-ink" href="/">Home</a>
          <a class="inline-flex items-center gap-1.5 rounded-full px-3 py-2 text-body transition-colors hover:text-ink" href="/calendar">Calendar</a>
          <button type="button" id="mega-btn" class="group inline-flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-2 text-body transition-colors hover:text-ink aria-expanded:text-ink" aria-expanded="false" aria-controls="mega">All calculators <svg class="transition-transform group-aria-expanded:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <button type="button" id="open-search" class="btn-ghost w-9 px-0 sm:w-auto sm:min-w-52 sm:justify-between sm:px-3" aria-label="Search calculators" aria-keyshortcuts="Control+K Meta+K">
            <span class="flex items-center gap-2 text-mute">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <span class="hidden sm:inline">Search…</span>
            </span>
            <kbd class="hidden font-mono text-xs text-mute sm:inline">Ctrl&nbsp;K</kbd>
          </button>
          <button type="button" id="mobile-btn" class="btn-ghost w-9 px-0 sm:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="group-aria-expanded:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
          <button type="button" id="theme-toggle" class="btn-ghost w-9 px-0" aria-label="Toggle dark mode">
            <svg class="dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
            <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
      <div id="mega" hidden class="drop-in absolute left-4 top-full z-40 mt-1 w-[min(880px,calc(100vw-3rem))] rounded-lg border border-hairline bg-elevated p-5 shadow-float max-sm:hidden! sm:left-6">
        <div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
          <div>
            <p class="eyebrow mb-2">{"Date & Time"}</p>
            <ul class="space-y-0.5">
              {calculators.filter((x) => x.category === "Date & Time").map((x) => <li><a href={`/${x.slug}`} class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-body transition-colors hover:bg-hairline-soft hover:text-ink"><span class="shrink-0 leading-none" style={`color:${accentOf(x)}`} set:html={iconSvg(x.icon, 16, 2)} />{x.name}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow mb-2">{"Health"}</p>
            <ul class="space-y-0.5">
              {calculators.filter((x) => x.category === "Health").map((x) => <li><a href={`/${x.slug}`} class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-body transition-colors hover:bg-hairline-soft hover:text-ink"><span class="shrink-0 leading-none" style={`color:${accentOf(x)}`} set:html={iconSvg(x.icon, 16, 2)} />{x.name}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow mb-2">{"Math"}</p>
            <ul class="space-y-0.5">
              {calculators.filter((x) => x.category === "Math").map((x) => <li><a href={`/${x.slug}`} class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-body transition-colors hover:bg-hairline-soft hover:text-ink"><span class="shrink-0 leading-none" style={`color:${accentOf(x)}`} set:html={iconSvg(x.icon, 16, 2)} />{x.name}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="eyebrow mb-2">{"Finance"}</p>
            <ul class="space-y-0.5">
              {calculators.filter((x) => x.category === "Finance").map((x) => <li><a href={`/${x.slug}`} class="flex items-center gap-2 rounded-sm px-2 py-1.5 text-body transition-colors hover:bg-hairline-soft hover:text-ink"><span class="shrink-0 leading-none" style={`color:${accentOf(x)}`} set:html={iconSvg(x.icon, 16, 2)} />{x.name}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="mt-4 border-t border-hairline pt-3"><a href="/calculators" class="text-sm font-medium text-link hover:underline">Browse all calculators</a></div>
      </div>

      <div id="mobile-menu" hidden class="drop-in max-h-[calc(100dvh-3.5rem)] overflow-y-auto overscroll-contain border-t border-hairline bg-canvas px-4 py-3 sm:hidden">
        <a href="/" class="block rounded-sm px-2 py-3 font-medium text-ink">Home</a>
        <a href="/calendar" class="block rounded-sm px-2 py-3 font-medium text-ink">Calendar</a>
        <p class="eyebrow mt-3 px-2">All calculators</p>
        <div class="mt-1 divide-y divide-hairline border-y border-hairline">
          {categories.map((c) => (
            <details class="group/acc">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between px-2 font-medium text-ink">
                {c}
                <svg class="transition-transform group-open/acc:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <ul class="drop-in pb-2">
                {calculators.filter((x) => x.category === c).map((x) => <li><a href={`/${x.slug}`} class="flex items-center gap-3 rounded-sm px-4 py-2.5 text-body hover:bg-hairline-soft hover:text-ink"><span class="shrink-0 leading-none" style={`color:${accentOf(x)}`} set:html={iconSvg(x.icon, 18, 2)} />{x.name}</a></li>)}
              </ul>
            </details>
          ))}
        </div>
      </div>
    </header>

    <main id="main" class="flex-1"><slot /></main>

    <footer class="mt-24 border-t border-hairline">
      <div class="container-page grid gap-10 py-12 sm:grid-cols-4">
        <div class="sm:col-span-2">
          <p class="font-semibold text-ink">AgeCalculates</p>
          <p class="mt-2 max-w-sm text-body">Fast, private calculators. Everything runs in your browser; nothing you enter is sent to a server.</p>
        </div>
        <div>
          <p class="eyebrow mb-3">Calculators</p>
          <ul class="space-y-2">{calculators.slice(0, 6).map((c) => <li><a class="hover:text-ink" href={`/${c.slug}`}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="eyebrow mb-3">More</p>
          <ul class="space-y-2">{calculators.slice(6).map((c) => <li><a class="hover:text-ink" href={`/${c.slug}`}>{c.name}</a></li>)}</ul>
        </div>
      </div>
      <div class="container-page border-t border-hairline py-6 text-xs text-mute">© {new Date().getFullYear()} agecalculates.com. Results are estimates for general information, not professional advice.</div>
    </footer>

    <dialog id="search" class="m-auto mt-[12vh] w-[min(36rem,calc(100vw-2rem))] rounded-lg border border-hairline bg-elevated p-0 text-body shadow-float backdrop:bg-black/40" aria-label="Search calculators">
      <div class="border-b border-hairline">
        <input id="search-input" type="search" class="h-12 w-full bg-transparent px-4 text-base text-ink placeholder:text-faint focus-visible:outline-none" placeholder="Search calculators…" autocomplete="off" spellcheck="false" aria-label="Search calculators" />
      </div>
      <ul id="search-results" class="max-h-80 overflow-y-auto overscroll-contain p-2" role="listbox"></ul>
    </dialog>

    <script is:inline define:vars={{ items: searchItems }}>
      (function () {
        var root = document.documentElement;
        document.getElementById("theme-toggle").addEventListener("click", function () {
          var dark = root.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
        });
        var megaBtn = document.getElementById("mega-btn"), mega = document.getElementById("mega"), mBtn = document.getElementById("mobile-btn"), mMenu = document.getElementById("mobile-menu");
        function setMenu(btn, panel, open) { panel.hidden = !open; btn.setAttribute("aria-expanded", String(open)); }
        function closeMenus() { setMenu(megaBtn, mega, false); setMenu(mBtn, mMenu, false); }
        megaBtn.addEventListener("click", function (e) { e.stopPropagation(); setMenu(megaBtn, mega, mega.hidden); setMenu(mBtn, mMenu, false); });
        mBtn.addEventListener("click", function (e) { e.stopPropagation(); setMenu(mBtn, mMenu, mMenu.hidden); setMenu(megaBtn, mega, false); });
        document.addEventListener("click", function (e) { if (!e.target.closest("#mega, #mobile-menu")) closeMenus(); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeMenus(); });
        matchMedia("(min-width: 640px)").addEventListener("change", closeMenus);
        var dlg = document.getElementById("search"), input = document.getElementById("search-input"), list = document.getElementById("search-results"), active = 0, shown = [];
        function render() {
          var q = input.value.trim().toLowerCase();
          shown = items.filter(function (i) { return !q || (i.name + " " + i.keywords).toLowerCase().indexOf(q) > -1; });
          active = Math.min(active, Math.max(0, shown.length - 1));
          list.innerHTML = shown.length ? "" : '<li class="px-3 py-6 text-center text-mute">No calculators found</li>';
          shown.forEach(function (i, n) {
            var li = document.createElement("li");
            li.setAttribute("role", "option");
            li.setAttribute("aria-selected", String(n === active));
            var a = document.createElement("a");
            a.href = "/" + i.slug;
            a.className = "block rounded-sm px-3 py-2 " + (n === active ? "bg-hairline-soft" : "");
            var t = document.createElement("span"); t.className = "block font-medium text-ink"; t.textContent = i.name;
            var d = document.createElement("span"); d.className = "block text-xs text-mute"; d.textContent = i.desc;
            a.appendChild(t); a.appendChild(d); li.appendChild(a); list.appendChild(li);
          });
        }
        function open() { closeMenus(); input.value = ""; active = 0; render(); dlg.showModal(); input.focus(); }
        document.getElementById("open-search").addEventListener("click", open);
        document.addEventListener("keydown", function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); if (dlg.open) dlg.close(); else open(); }
        });
        input.addEventListener("input", function () { active = 0; render(); });
        input.addEventListener("keydown", function (e) {
          if (e.key === "ArrowDown") { e.preventDefault(); active = Math.min(active + 1, shown.length - 1); render(); }
          else if (e.key === "ArrowUp") { e.preventDefault(); active = Math.max(active - 1, 0); render(); }
          else if (e.key === "Enter" && shown[active]) { e.preventDefault(); location.href = "/" + shown[active].slug; }
        });
        dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
      })();
    </script>
  </body>
</html>
